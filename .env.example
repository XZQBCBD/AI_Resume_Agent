# ============================================================
# AI 数字分身 RAG 系统 — 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env
# ============================================================

# --- LLM API 密钥（至少填一个）---
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-your-openai-key
CUSTOM_API_KEY=
LLM_PROVIDER=deepseek

# --- 自定义 LLM Provider（可选）---
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=

# --- HuggingFace 镜像（国内用户必须）---
HF_ENDPOINT=https://hf-mirror.com

# --- 模型缓存路径（避免占用系统盘）---
MODEL_CACHE_DIR=E:/AI_Cache/huggingface

# --- 数据路径（可选，默认 ./data/raw）---
# DATA_RAW_PATH=
# VECTOR_DB_PATH=

# --- RAG 检索参数 ---
TOP_K_RETRIEVAL=8
TOP_K_CANDIDATE=10
RRF_K=60
WEIGHT_PRESET=balanced
MMR_LAMBDA=0.7
DEDUP_SIM_THRESHOLD=0.85
SECTION_BOOST_FACTOR=1.2
BM25_SCORE_THRESHOLD=0.05
TEMPERATURE=0.1
DEBUG_RETRIEVER=false

# --- 文档切分参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Embedding 模型 ---
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
