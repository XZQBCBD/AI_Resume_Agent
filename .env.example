# ============================================================
# AI Resume Agent - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- LLM API 密钥（至少填一个）---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
CUSTOM_API_KEY=sk-your-custom-key-here

# --- LLM Provider 选择（deepseek / openai / custom）---
LLM_PROVIDER=deepseek

# --- 自定义 API 配置（仅 LLM_PROVIDER=custom 时需要）---
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
CUSTOM_MODEL_NAME=your-model-name

# --- 数据路径（可选，默认在项目目录下）---
# DATA_RAW_PATH=E:/MyDocs/resume_data
# VECTOR_DB_PATH=D:/VectorDB
# MODEL_CACHE_DIR=E:/AI_Cache/huggingface
