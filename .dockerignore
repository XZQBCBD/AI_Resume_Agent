# ============================================================
# Docker 构建忽略文件
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# 虚拟环境
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# 环境变量（通过 docker-compose 传入，不要打包进镜像）
.env

# 向量数据库（运行时通过 volume 挂载）
vector_db/

# 文档
docs/
*.md
!README.md

# 测试
tests/

# Claude 配置
.claude/

# 临时文件
*.log
*.tmp
.DS_Store
Thumbs.db
